{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://castarro.local/schemas/stream-profile.schema.json",
  "title": "StreamProfile",
  "type": "object",
  "required": ["id", "channelId", "mode", "loopEnabled", "restartOnExit", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "channelId": { "type": "string", "minLength": 1 },
    "videoAssetId": { "type": ["string", "null"] },
    "mode": { "type": "string", "enum": ["manualKey", "youtubeAccount"] },
    "rtmpServerUrl": { "type": ["string", "null"] },
    "streamKeySecretRef": { "type": ["string", "null"] },
    "youtubeBroadcastId": { "type": ["string", "null"] },
    "loopEnabled": { "type": "boolean" },
    "restartOnExit": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
