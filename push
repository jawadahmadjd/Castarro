#!/usr/bin/env python3
"""
Automate release push flow for Castarro:
1) Optional local desktop + mobile release preflight checks
2) Version bump in package.json (+ package-lock.json)
3) Commit and push branch

GitHub Actions workflow on main then:
- checks whether tag v<version> exists
- builds and publishes Windows installer + signed Android APK when version is new
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Iterable


ROOT = Path(__file__).resolve().parent
PACKAGE_JSON = ROOT / "package.json"
PACKAGE_LOCK = ROOT / "package-lock.json"
SEMVER_RE = re.compile(r"^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?$")
DIGIT_CYCLE_RE = re.compile(r"^(\d+)\.(\d+)\.(\d+)$")


def read_bool_env(name: str, default: bool) -> bool:
    value = os.getenv(name)
    if value is None:
        return default
    return value.strip().lower() in {"1", "true", "yes", "on"}


def run(
    cmd: Iterable[str],
    *,
    cwd: Path = ROOT,
    capture_output: bool = False,
    check: bool = True,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    cmd_list = list(cmd)
    pretty = " ".join(shlex.quote(part) for part in cmd_list)
    print(f"\n[run] {pretty}")
    result = subprocess.run(
        cmd_list,
        cwd=str(cwd),
        check=False,
        text=True,
        capture_output=capture_output,
        env=env,
    )
    if result.stdout and capture_output:
        print(result.stdout.strip())
    if result.stderr:
        print(result.stderr.strip(), file=sys.stderr)
    if check and result.returncode != 0:
        raise RuntimeError(f"Command failed with exit code {result.returncode}: {pretty}")
    return result


def require_tool(name: str) -> None:
    if shutil.which(name):
        return
    if os.name == "nt" and shutil.which(f"{name}.cmd"):
        return
    raise RuntimeError(f"Required tool not found in PATH: {name}")


def git_output(*args: str) -> str:
    result = run(["git", *args], capture_output=True)
    return result.stdout.strip()


def ensure_project_layout() -> None:
    if not PACKAGE_JSON.exists():
        raise RuntimeError(f"Missing {PACKAGE_JSON}")
    if not (ROOT / ".git").exists():
        raise RuntimeError("This script must run from the repo root (missing .git folder).")


def ensure_inside_git_repo() -> None:
    out = git_output("rev-parse", "--is-inside-work-tree")
    if out.lower() != "true":
        raise RuntimeError("Current directory is not inside a git work tree.")


def get_current_branch() -> str:
    branch = git_output("rev-parse", "--abbrev-ref", "HEAD")
    if branch == "HEAD":
        raise RuntimeError("Detached HEAD is not supported for release push.")
    return branch


def validate_semver(version: str) -> None:
    if not SEMVER_RE.match(version):
        raise RuntimeError(
            f"Invalid version '{version}'. Expected format like 1.2.3 or 1.2.3-beta.1"
        )


def get_package_version() -> str:
    data = json.loads(PACKAGE_JSON.read_text(encoding="utf-8"))
    version = data.get("version")
    if not isinstance(version, str):
        raise RuntimeError("package.json does not contain a string 'version' field.")
    return version


def next_digit_cycle_version(current_version: str) -> str:
    match = DIGIT_CYCLE_RE.match(current_version)
    if not match:
        raise RuntimeError(
            "Digit-cycle versioning requires a plain x.y.z version (no prerelease suffix). "
            f"Current version is '{current_version}'."
        )
    major, minor, patch = (int(match.group(1)), int(match.group(2)), int(match.group(3)))

    if patch < 9:
        patch += 1
    else:
        patch = 0
        minor += 1
        if minor > 9:
            minor = 0
            major += 1
    return f"{major}.{minor}.{patch}"


def resolve_target_version(
    *,
    current_version: str,
    explicit_version: str | None,
    bump: str,
    preid: str | None,
    version_strategy: str,
) -> str | None:
    if explicit_version:
        validate_semver(explicit_version)
        return explicit_version
    if version_strategy == "digit-cycle" and bump == "patch" and not preid:
        return next_digit_cycle_version(current_version)
    return None


def bump_version(
    *,
    current_version: str,
    version: str | None,
    bump: str,
    preid: str | None,
    version_strategy: str,
) -> str:
    cmd = ["npm.cmd" if os.name == "nt" else "npm", "version"]
    target_version = resolve_target_version(
        current_version=current_version,
        explicit_version=version,
        bump=bump,
        preid=preid,
        version_strategy=version_strategy,
    )
    cmd.append(target_version or bump)
    cmd.append("--no-git-tag-version")
    if preid:
        cmd.extend(["--preid", preid])
    run(cmd)
    new_version = get_package_version()
    print(f"[info] New version: {new_version}")
    return new_version


def run_desktop_build_check(skip: bool) -> None:
    if skip:
        print("[info] Skipping desktop release preflight check.")
        return
    cmd = ["npm.cmd" if os.name == "nt" else "npm", "run", "release:check"]
    env = None
    if os.name == "nt":
        env = os.environ.copy()
        if not env.get("CASTARRO_INSTALLER_SMOKE_ROOT"):
            env["CASTARRO_INSTALLER_SMOKE_ROOT"] = r"C:\tmp"
            print("[info] Using CASTARRO_INSTALLER_SMOKE_ROOT=C:\\tmp for installer smoke.")
        else:
            print(f"[info] Using CASTARRO_INSTALLER_SMOKE_ROOT={env['CASTARRO_INSTALLER_SMOKE_ROOT']}")
        smoke_root = Path(env["CASTARRO_INSTALLER_SMOKE_ROOT"]).expanduser()
        try:
            smoke_root.mkdir(parents=True, exist_ok=True)
            probe = smoke_root / ".castarro-write-probe"
            probe.write_text("ok", encoding="utf-8")
            probe.unlink(missing_ok=True)
        except Exception as exc:
            raise RuntimeError(
                "Installer smoke root is not writable. "
                "Set CASTARRO_INSTALLER_SMOKE_ROOT to a writable path, e.g. C:\\tmp. "
                f"Current value: {smoke_root}"
            ) from exc
    run(cmd, env=env)


def run_mobile_build_check(skip: bool) -> None:
    if skip:
        print("[info] Skipping mobile release preflight check.")
        return
    cmd = ["npm.cmd" if os.name == "nt" else "npm", "run", "verify:mobile"]
    run(cmd)


def ensure_remote_tag_absent(remote: str, tag: str) -> None:
    result = run(["git", "ls-remote", "--tags", remote, f"refs/tags/{tag}"], capture_output=True)
    if result.stdout.strip():
        raise RuntimeError(
            f"Remote tag already exists: {tag}. "
            "Bump to a newer version so GitHub Actions can publish a fresh release."
        )


def stage_files(stage_all: bool) -> None:
    if stage_all:
        run(["git", "add", "-A"])
        return
    run(["git", "add", str(PACKAGE_JSON)])
    if PACKAGE_LOCK.exists():
        run(["git", "add", str(PACKAGE_LOCK)])


def ensure_staged_changes() -> None:
    result = run(["git", "diff", "--cached", "--quiet"], check=False)
    if result.returncode == 0:
        raise RuntimeError("No staged changes to commit.")


def commit_changes(message: str) -> None:
    run(["git", "commit", "-m", message])


def push_branch(remote: str, branch: str) -> None:
    run(["git", "push", remote, branch])


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="One-command release push (bump version, commit, push)."
    )
    parser.add_argument(
        "--bump",
        default=os.getenv("PUSH_DEFAULT_BUMP", "patch"),
        choices=["patch", "minor", "major", "prepatch", "preminor", "premajor", "prerelease"],
        help="Bump type (ignored when --version is provided).",
    )
    parser.add_argument(
        "--version-strategy",
        default=os.getenv("PUSH_VERSION_STRATEGY", "digit-cycle"),
        choices=["digit-cycle", "semver"],
        help="Auto version strategy. digit-cycle follows x.y.0..x.y.9 then x.(y+1).0, with x.9.9 -> (x+1).0.0.",
    )
    parser.add_argument(
        "--version",
        help="Set an explicit version, e.g. 1.0.1 (instead of using --bump).",
    )
    parser.add_argument(
        "--preid",
        default=os.getenv("PUSH_PREID"),
        help="Prerelease identifier for prerelease bumps, e.g. beta.",
    )
    parser.add_argument(
        "--remote",
        default=os.getenv("PUSH_REMOTE", "origin"),
        help="Git remote to push to.",
    )
    parser.add_argument(
        "--branch",
        default=os.getenv("PUSH_BRANCH"),
        help="Branch to push (defaults to current branch).",
    )
    parser.add_argument(
        "--message",
        default=os.getenv("PUSH_COMMIT_MESSAGE"),
        help="Custom git commit message.",
    )
    parser.add_argument(
        "--no-stage-all",
        action="store_true",
        help="Do not stage every change; stage only version files.",
    )
    parser.add_argument(
        "--no-build-check",
        action="store_true",
        help="Skip running desktop and mobile preflight checks before push.",
    )
    parser.add_argument(
        "--no-mobile-check",
        action="store_true",
        help="Skip only the mobile preflight check (`npm run verify:mobile`).",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show push plan and exit without changing anything.",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()

    require_tool("git")
    require_tool("npm")
    ensure_project_layout()
    ensure_inside_git_repo()

    branch = args.branch or get_current_branch()
    old_version = get_package_version()

    stage_all = not args.no_stage_all
    run_check = not args.no_build_check and read_bool_env("PUSH_RUN_BUILD_CHECK", True)
    run_mobile_check = run_check and not args.no_mobile_check and read_bool_env("PUSH_RUN_MOBILE_CHECK", True)
    if args.no_build_check:
        run_check = False
        run_mobile_check = False

    if args.dry_run:
        target = resolve_target_version(
            current_version=old_version,
            explicit_version=args.version,
            bump=args.bump,
            preid=args.preid,
            version_strategy=args.version_strategy,
        ) or f"{args.bump} (from {old_version}, strategy={args.version_strategy})"
        print("[dry-run] Planned release actions:")
        print(f"  - branch: {branch}")
        print(f"  - remote: {args.remote}")
        print(f"  - version: {target}")
        print(f"  - stage_all: {stage_all}")
        print(f"  - desktop_preflight_check: {run_check}")
        print(f"  - mobile_preflight_check: {run_mobile_check}")
        print("  - tags/assets: handled by GitHub Action on main push")
        print("  - release assets: Windows installer + signed Android APK")
        return 0

    run_desktop_build_check(skip=not run_check)
    run_mobile_build_check(skip=not run_mobile_check)
    new_version = bump_version(
        current_version=old_version,
        version=args.version,
        bump=args.bump,
        preid=args.preid,
        version_strategy=args.version_strategy,
    )

    expected_tag = f"v{new_version}"
    ensure_remote_tag_absent(args.remote, expected_tag)

    stage_files(stage_all=stage_all)
    ensure_staged_changes()

    commit_message = args.message or f"chore(release): {expected_tag}"
    commit_changes(commit_message)
    push_branch(args.remote, branch)

    print("\n[success] Release push completed.")
    print(f"[success] Commit pushed to {args.remote}/{branch}")
    print(
        f"[info] GitHub Action on '{branch}' should build and publish {expected_tag} "
        "with Windows installer + signed Android APK if workflow checks pass."
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"[error] {exc}", file=sys.stderr)
        raise SystemExit(1)
